<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/status_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="模块运行与自检状态"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/status_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#14000000"
            android:textSize="13sp"
            android:textIsSelectable="true"
            android:text="正在检测微信环境…" />

        <Button
            android:id="@+id/goto_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/go_to_settings" />

        <Button
            android:id="@+id/btn_refresh_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="刷新微信自检与 Hook 状态" />

        <Button
            android:id="@+id/btn_export_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="导出配置备份文件 (.json)" />

        <Button
            android:id="@+id/btn_import_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="导入配置备份并同步至微信" />

        <Button
            android:id="@+id/btn_view_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="查看 / 清理运行日志 (trace.log)" />

        <Button
            android:id="@+id/goto_wechat_appinfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/goto_wechat_appinfo" />
    </LinearLayout>
</ScrollView>
